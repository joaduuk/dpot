# Copy to .env and fill in. Never commit the real .env.
DATABASE_URL=postgresql://dailypot_user:CHANGE_ME@localhost:5432/dailypot_db
# Set to production on the server.
ENVIRONMENT=development

# Required in production (at least 32 characters). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
APP_NAME=DailyPot

# Websites allowed to call the API from a browser, comma-separated.
# Production: https://dailypot.online,https://www.dailypot.online
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Email (sign-up confirmation and password reset).
# Leave SMTP_USER/SMTP_PASS blank locally: emails, including their links, are
# printed to the backend console instead of being sent.
# Production uses the Hostinger mailbox support@dailypot.online:
#   SMTP_HOST=smtp.hostinger.com
#   SMTP_PORT=465   (implicit SSL; 587 also works and uses STARTTLS instead)
#   SMTP_USER=support@dailypot.online
#   SMTP_PASS=<the mailbox password, typed on the server only>
#   EMAIL_FROM=support@dailypot.online
# FRONTEND_URL above must be https://dailypot.online in production, since the
# links in these emails are built from it.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Contact form: where messages from /contact are emailed (default below).
CONTACT_TO=support@dailypot.online
