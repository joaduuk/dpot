# Copy to .env and fill in. Never commit the real .env.
DATABASE_URL=postgresql://dailypot_user:CHANGE_ME@localhost:5432/dailypot_db
# Set to production on the server.
ENVIRONMENT=development

# Required in production (at least 32 characters). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
APP_NAME=DailyPot

# Websites allowed to call the API from a browser, comma-separated.
# Production: https://dailypot.online,https://www.dailypot.online
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Email (password reset). Leave blank locally: links are printed to the console.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
